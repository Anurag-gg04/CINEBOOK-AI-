# Local development defaults only. Replace every example secret outside an isolated workstation.
MYSQL_DATABASE=cinebook
MYSQL_USER=cinebook
MYSQL_PASSWORD=cinebook_dev_only
MYSQL_ROOT_PASSWORD=local_root_only_change_me
DB_URL=jdbc:mysql://mysql:3306/cinebook?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=cinebook
DB_PASSWORD=cinebook_dev_only
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=local-only-change-this-random-secret-before-sharing-2026
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
SEAT_HOLD_MINUTES=5
SERVER_PORT=8080
APP_CACHE_TYPE=redis
APP_REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
APP_MESSAGING_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=cinebook
RABBITMQ_PASSWORD=cinebook_dev_only
PAYMENT_MODE=SIMULATOR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Account email notifications (welcome email + successful sign-in alerts).
# Gmail: use a Google App Password, not your normal account password.
APP_MAIL_ENABLED=false
APP_MAIL_LOGIN_ALERTS=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set MAIL_FROM to the same verified mailbox used by MAIL_USERNAME.

# Seed demo users only for local development. Set false before any shared deployment.
APP_SEED_ENABLED=true
API_DOCS_PUBLIC=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_PUBLIC_URL=http://localhost:5173
APP_EMAIL_VERIFICATION_REQUIRED=false
