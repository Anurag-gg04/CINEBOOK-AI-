# Copy to .env.production and replace every CHANGE_ME value before deployment.
MYSQL_DATABASE=cinebook
MYSQL_USER=cinebook_app
MYSQL_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_PASSWORD
DB_POOL_SIZE=10

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_48_RANDOM_BYTES
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# Public HTTPS URL; must match the domain and CORS origin exactly.
APP_PUBLIC_URL=https://cinebook.example.com
CORS_ALLOWED_ORIGINS=https://cinebook.example.com
WEB_PORT=8088

# Private internal services. Redis is protected with this password in production.
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
RABBITMQ_USERNAME=cinebook_app
RABBITMQ_PASSWORD=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_PASSWORD

# SMTP: use a provider app password/API relay credential, never a normal mailbox password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-mailbox@gmail.com
MAIL_PASSWORD=CHANGE_ME_SMTP_APP_PASSWORD
MAIL_FROM=your-mailbox@gmail.com

# Start with Razorpay test credentials. Do not use live payment credentials until
# the webhook, refund and reconciliation workflows have been independently tested.
PAYMENT_MODE=RAZORPAY
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
