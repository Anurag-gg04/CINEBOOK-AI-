{
  "name": "cinebook-ai-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check lib/proxy.js && node --check api/[...path].js && node --check api/oauth2/[...path].js && node --check api/login/oauth2/[...path].js"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.9",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
